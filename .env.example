# Local SQLite file by default. For production use a libSQL/Turso URL.
DATABASE_URL=file:./data/kayal.db
DATABASE_AUTH_TOKEN=

# Long random string (32+ chars). Signs preview links and quote links.
APP_SECRET=

# Public base URL used in sitemap, emails and quote links.
SITE_URL=http://localhost:3000

# Optional: any OpenAI-compatible chat endpoint for LLM-assisted extraction.
# Leave empty to use the built-in rules engine only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
